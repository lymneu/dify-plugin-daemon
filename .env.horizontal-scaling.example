# Dify Plugin Daemon 水平扩展配置示例

# === 水平扩展核心配置 ===
ENABLE_DISTRIBUTED_MODE=true
ENABLE_SESSION_LOCAL_CACHE=true
DISTRIBUTED_SESSION_TTL=2h
DISTRIBUTED_PLUGIN_STATE_TTL=30m
LOAD_BALANCING_STRATEGY=round_robin
NODE_HEALTH_CHECK_INTERVAL=30s
PLUGIN_STATE_SYNC_INTERVAL=10s
AUTO_CLEANUP_INTERVAL=5m
DISABLE_REDIRECTION=true
CLUSTER_DISCOVERY_MODE=redis

# === 基础服务配置 ===
SERVER_PORT=3333
SERVER_KEY=your-secret-server-key
DIFY_INNER_API_URL=http://dify-api:5001
DIFY_INNER_API_KEY=your-dify-api-key

# === Redis配置（分布式状态存储） ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# === 数据库配置 ===
DB_TYPE=postgresql
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=dify_plugin_daemon
DB_DEFAULT_DATABASE=postgres
DB_SSL_MODE=disable

# === 存储和插件配置 ===
PLUGIN_STORAGE_TYPE=local
PLUGIN_WORKING_PATH=/app/plugins
PLUGIN_INSTALLED_PATH=/app/installed
PLUGIN_MAX_EXECUTION_TIMEOUT=300
PLATFORM=local
ROUTINE_POOL_SIZE=100